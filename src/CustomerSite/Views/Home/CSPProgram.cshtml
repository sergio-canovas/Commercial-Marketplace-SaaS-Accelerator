@{
    ViewData["Title"] = "CSP Program";
}

<div class="cm-panel-default mt40">
    <h1 class="cm-section-heading">🚀 CSP Program: dForts Copilot Readiness Monitor</h1>
    <p class="text-muted">Information for Partners and Customers &nbsp;·&nbsp; May 2026</p>

    <div class="card mt20 shadow-sm">
        <div class="card-body p-4">
            <h2 class="text-primary h4 mb-3">Program Summary</h2>
            <p>Welcome to the informational page for the <strong>dForts Copilot Readiness Monitor</strong> CSP program. Here you will find key details for activation and license management through our partnership model.</p>

            <div class="table-responsive mt40">
                <table class="table table-bordered cm-table">
                    <thead class="cm-table-head">
                        <tr>
                            <th>Element</th>
                            <th>Details for dForts</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="font-weight-bold"><strong>What the product does</strong></td>
                            <td><strong>Copilot Readiness Monitor:</strong> Specialized tool for monitoring Microsoft 365 Copilot readiness, focusing on detecting and mitigating information <em>oversharing</em> risks.</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold"><strong>Who it is for</strong></td>
                            <td>IT Admins and Site Owners using or planning to implement M365 Copilot.</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold"><strong>Price / Model</strong></td>
                            <td>Flat Rate with pricing established per Tenant.</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold"><strong>How to activate it</strong></td>
                            <td>The customer can perform activation autonomously through the official dForts portal after acquisition.</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold"><strong>Partner contact</strong></td>
                            <td>For inquiries about the partner program, contact <a href="mailto:info@dforts.com">info@dforts.com</a> or visit our contact page.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="mt50 p-4 bg-light rounded border text-center">
                <h3 class="h5">Ready to get started?</h3>
                <p>If you already have a subscription, you can access the administration portal to configure your tools.</p>
                <a asp-action="Index" asp-controller="Home" class="cm-button-default" style="text-decoration:none;">Access the Portal</a>
            </div>
        </div>
    </div>
</div>
