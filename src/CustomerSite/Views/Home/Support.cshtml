@{
    ViewData["Title"] = "Support";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-2">
            <h3 class="mb-0" style="color: #004578;"><i class="fa fa-life-ring text-primary me-2"></i> Support & Contact</h3>
        </div>
        <div class="card-body p-4 pt-2">
            <div class="row">
                <div class="col-md-7">
                    <h5 class="border-bottom pb-2 mb-4 mt-3 text-secondary">How can we help?</h5>
                    <p class="text-muted">
                        If you are experiencing issues with the <strong>dForts: Copilot Readiness Monitor</strong> or have questions about your subscription, our team is here to assist you.
                    </p>

                    <div class="d-flex align-items-start mb-4 mt-4">
                        <div class="bg-light p-3 rounded-circle me-3">
                            <i class="fa fa-envelope fa-2x text-primary"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Email Support</h6>
                            <p class="mb-0">Send us an email at <a href="mailto:support@dforts.com" class="text-decoration-none fw-semibold">support@dforts.com</a></p>
                            <small class="text-muted">Typical response time: within 24 hours.</small>
                        </div>
                    </div>

                    <div class="d-flex align-items-start mb-4">
                        <div class="bg-light p-3 rounded-circle me-3">
                            <i class="fa fa-book fa-2x text-primary"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Self-Service Documentation</h6>
                            <p class="mb-0">Check our comprehensive <a href="~/manual/index.html" target="_blank" class="text-decoration-none fw-semibold">User Guide</a> for quick answers.</p>
                            <small class="text-muted">Includes step-by-step remediation and scanning tips.</small>
                        </div>
                    </div>

                    <div class="d-flex align-items-start mb-4">
                        <div class="bg-light p-3 rounded-circle me-3">
                            <i class="fa fa-external-link fa-2x text-primary"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Marketplace Issues</h6>
                            <p class="mb-0">For billing or Microsoft account issues, visit the <a href="https://azuremarketplace.microsoft.com/en-us/support" target="_blank" class="text-decoration-none fw-semibold">Azure Marketplace Support</a>.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="bg-light p-4 rounded-3 border">
                        <h6 class="fw-bold mb-3"><i class="fa fa-info-circle me-2"></i> About dForts</h6>
                        <p class="small text-muted mb-3">
                            dForts is dedicated to helping organizations secure their data for the age of AI. Our tools simplify governance and risk management in M365.
                        </p>
                        <a href="https://dforts.com" target="_blank" class="btn btn-outline-primary btn-sm w-100">Visit dforts.com</a>
                    </div>
                    
                    <div class="mt-4 text-center">
                        <img src="~/logo.jpeg" alt="dForts Logo" style="max-width: 150px; opacity: 0.8;" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
